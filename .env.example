# Names only — never put real values in this file (rules.md §2.3, §10)

# --- Backend (backend/.env) ---
ENV=development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only for projects still on the legacy JWT secret. New projects verify tokens with the
# public signing keys at SUPABASE_URL/auth/v1/.well-known/jwks.json (backend/app/core/auth.py).
SUPABASE_JWT_SECRET=
DATABASE_URL=
REDIS_URL=
ANTHROPIC_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
# Sarvam AI (assistant chat + translation). Backend only — never put this in a VITE_ variable.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
CHAT_MESSAGES_PER_MINUTE=12
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_TEMPLATE_SIDS=
SUPABASE_SEND_SMS_HOOK_SECRET=
SENTRY_DSN=
CORS_ORIGINS=

# --- Frontend (copy into frontend/.env.local — public values only, never a secret/service key) ---
# Supabase dashboard → Project Settings → API Keys. Set both to turn on real sign-in
# (email + password, Google, WhatsApp); leave empty to use the demo accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy name, still read if VITE_SUPABASE_PUBLISHABLE_KEY is empty:
VITE_SUPABASE_ANON_KEY=
# Leave empty to run the frontend on built-in demo data (no backend needed)
VITE_API_BASE_URL=
# Only the assistant on the real backend while other screens stay on demo data:
# http://localhost:8000 locally, "/" on Vercel (backend served at /api on the same domain).
VITE_CHAT_API_BASE_URL=
